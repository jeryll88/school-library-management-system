{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/login(\\.php)?",
      "dest": "/api/login.php"
    },
    {
      "src": "/register(\\.php)?",
      "dest": "/api/register.php"
    },
    {
      "src": "/forgot_password(\\.php)?",
      "dest": "/api/forgot_password.php"
    },
    {
      "src": "/logout(\\.php)?",
      "dest": "/api/logout.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/app.php"
    }
  ]
}
