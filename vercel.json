{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "client/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "server/api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/client/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/login",
      "dest": "/login.php"
    },
    {
      "src": "/register",
      "dest": "/register.php"
    },
    {
      "src": "/forgot_password",
      "dest": "/forgot_password.php"
    },
    {
      "src": "/logout",
      "dest": "/logout.php"
    },
    {
      "src": "/index.php",
      "dest": "/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
